// Merge these matches INSIDE the existing service cloud.firestore /databases/{database}/documents.
// Do not replace the project's other rules. Remove any broader overlapping allow rule.
// Prototype: deploy only after emulator tests and authenticated staging verification.
match /masarAuthority/{uid}/matrices/{clientId} {
  function owner() {
    return request.auth != null && request.auth.uid == uid
      && request.auth.token.email == 'naif123456@gmail.com'
      && request.auth.token.email_verified == true
      && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function valid(d) {
    return d.keys().hasAll(['ownerUid','clientId','clientName','matrixJson','memory','status','revision','createdAt','updatedAt'])
      && d.keys().hasOnly(['ownerUid','clientId','clientName','matrixJson','memory','status','revision','createdAt','updatedAt'])
      && d.ownerUid == uid && d.clientId == clientId
      && d.clientName is string && d.clientName.size() > 0 && d.clientName.size() <= 300
      && d.matrixJson is string && d.matrixJson.size() <= 700000
      && d.memory is string && d.memory.size() <= 12000
      && d.status in ['draft','review','approved']
      && d.revision is int && d.revision > 0
      && d.createdAt is timestamp && d.updatedAt == request.time;
  }
  function versionMatches(d) {
    return getAfter(/databases/$(database)/documents/masarAuthority/$(uid)/matrices/$(clientId)/versions/$(string(d.revision))).data == d;
  }
  allow read: if owner();
  allow create: if owner() && valid(request.resource.data)
    && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
    && versionMatches(request.resource.data);
  allow update: if owner() && valid(request.resource.data)
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.revision == resource.data.revision + 1
    && versionMatches(request.resource.data);
  allow delete: if false;
  match /versions/{versionId} {
    allow read: if owner();
    allow create: if owner() && valid(request.resource.data)
      && versionId == string(request.resource.data.revision)
      && getAfter(/databases/$(database)/documents/masarAuthority/$(uid)/matrices/$(clientId)).data == request.resource.data;
    allow update, delete: if false;
  }
}
